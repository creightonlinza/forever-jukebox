    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "terser": "^5.46.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.44.1",
    "vite": "^5.4.0",
    "vitest": "^1.6.0"
